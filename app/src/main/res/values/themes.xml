<resources>
    <!-- Базовый стиль приложения -->
    <style name="Theme.Trace" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Основные цвета -->
        <item name="colorPrimary">#F8BBD0</item> <!-- Розовый -->
        <item name="colorSecondary">#AECBFA</item> <!-- Голубой -->
        <item name="android:windowBackground">@drawable/bg_main_gradient</item>
    </style>

    <!-- Стили для текста -->
    <style name="TextAppearance.Trace.Title" parent="TextAppearance.MaterialComponents.Headline4">
        <item name="fontFamily">@font/comfortaa_bold</item>
        <item name="android:textColor">#333333</item>
    </style>

    <style name="TextAppearance.Trace.Subtitle" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="fontFamily">@font/nunito_bold</item>
        <item name="android:textColor">#666666</item>
    </style>

    <style name="TextAppearance.Trace.Body" parent="TextAppearance.MaterialComponents.Body1">
        <item name="fontFamily">@font/comfortaa_semibold</item>
        <item name="android:textColor">#333333</item>
    </style>

    <style name="TextAppearance.Trace.Logo" parent="TextAppearance.MaterialComponents.Headline1">
        <item name="fontFamily">@font/nunito_black</item>
        <item name="android:textColor">#FFB6C1</item> <!-- Светло-розовый -->
    </style>
</resources>