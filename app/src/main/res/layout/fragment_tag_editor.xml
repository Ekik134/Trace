<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#80000000"> <!-- Полупрозрачный фон для эффекта диалога -->

    <!-- Основная карточка -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardEditor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="24dp"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="12dp"
        app:cardElevation="8dp"
        app:strokeColor="#5C5C7A"
        app:strokeWidth="4dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="20dp">

            <!-- Кнопка закрытия (крестик) -->
            <ImageButton
                android:id="@+id/btnClose"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                app:tint="#B0BEC5"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Заголовок "Редактирование" -->
            <TextView
                android:id="@+id/tvEditorTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Редактирование"
                android:textAppearance="@style/TextAppearance.Trace.Title"
                android:textSize="22sp"
                android:textColor="#333333"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <!-- Разделитель под заголовком -->
            <View
                android:id="@+id/titleDivider"
                android:layout_width="120dp"
                android:layout_height="4dp"
                android:layout_marginTop="4dp"
                android:background="#90CAF9"
                app:layout_constraintTop_toBottomOf="@id/tvEditorTitle"
                app:layout_constraintStart_toStartOf="parent" />

            <!-- Поле: Название -->
            <TextView
                android:id="@+id/tvNameLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Название"
                android:textAppearance="@style/TextAppearance.Trace.Body"
                android:textSize="18sp"
                android:textColor="#333333"
                app:layout_constraintTop_toBottomOf="@id/titleDivider"
                app:layout_constraintStart_toStartOf="parent" />

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/etName"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_input_field"
                android:fontFamily="@font/comfortaa_semibold"
                android:hint="название..."
                android:maxLength="30"
                android:paddingHorizontal="16dp"
                android:textColor="#333333"
                android:textColorHint="#B0BEC5"
                android:textSize="16sp"
                app:layout_constraintTop_toBottomOf="@id/tvNameLabel" />

            <!-- Блок: Связи -->
            <TextView
                android:id="@+id/tvConnectionsLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Связи"
                android:textAppearance="@style/TextAppearance.Trace.Title"
                android:textSize="20sp"
                android:textColor="#333333"
                app:layout_constraintTop_toBottomOf="@id/etName"
                app:layout_constraintStart_toStartOf="parent" />

            <!-- Подблок: Входит в -->
            <TextView
                android:id="@+id/tvEntersInLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Входит в"
                android:textSize="16sp"
                android:textColor="#333333"
                android:fontFamily="@font/comfortaa_semibold"
                app:layout_constraintTop_toBottomOf="@id/tvConnectionsLabel"
                app:layout_constraintStart_toStartOf="parent" />

            <ImageButton
                android:id="@+id/btnAddParent"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_input_add"
                app:tint="#66BB6A"
                app:layout_constraintTop_toTopOf="@id/tvEntersInLabel"
                app:layout_constraintBottom_toBottomOf="@id/tvEntersInLabel"
                app:layout_constraintStart_toEndOf="@id/tvEntersInLabel" />

            <!-- Контейнер для родительских тегов -->
            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupParents"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="4dp"
                app:chipSpacingHorizontal="8dp"
                app:layout_constraintTop_toBottomOf="@id/tvEntersInLabel" />

            <!-- Подблок: Включает в себя -->
            <TextView
                android:id="@+id/tvIncludesLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Включает в себя"
                android:textSize="16sp"
                android:textColor="#333333"
                android:fontFamily="@font/comfortaa_semibold"
                app:layout_constraintTop_toBottomOf="@id/chipGroupParents"
                app:layout_constraintStart_toStartOf="parent" />

            <ImageButton
                android:id="@+id/btnAddChild"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_input_add"
                app:tint="#66BB6A"
                app:layout_constraintTop_toTopOf="@id/tvIncludesLabel"
                app:layout_constraintBottom_toBottomOf="@id/tvIncludesLabel"
                app:layout_constraintStart_toEndOf="@id/tvIncludesLabel" />

            <!-- Контейнер для дочерних тегов -->
            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupChildren"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="4dp"
                app:chipSpacingHorizontal="8dp"
                app:layout_constraintTop_toBottomOf="@id/tvIncludesLabel" />

            <!-- Кнопка Удалить (слева) -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnDelete"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_button_pink"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:paddingHorizontal="24dp"
                android:stateListAnimator="@null"
                android:text="Удалить"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                app:layout_constraintTop_toBottomOf="@id/chipGroupChildren"
                app:layout_constraintStart_toStartOf="parent" />

            <!-- Кнопка Сохранить -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnSave"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_button_green"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:paddingHorizontal="32dp"
                android:stateListAnimator="@null"
                android:text="Сохранить"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                app:layout_constraintTop_toBottomOf="@id/btnDelete"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Кнопка Отмена -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnCancel"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_button_red"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:paddingHorizontal="32dp"
                android:stateListAnimator="@null"
                android:text="Отмена"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                app:layout_constraintTop_toBottomOf="@id/btnSave"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>